PORT=4001
MONGODB_URI=mongodb://127.0.0.1:27017/school_kids_tracker
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# Optional Mapbox (server-side helpers if used)
MAPBOX_PUBLIC_TOKEN=pk.your_mapbox_public_token_here

# Parent push (best-effort — omit to keep in-app + Socket.IO only)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or: GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccount.json
#
# Generate VAPID with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourschool.test
